# Contract test suite configuration.
#
# Copy to .env and load it yourself, or export these directly. The suite reads the process
# environment and nothing else, so it works the same in a shell, in CI and in a container.
# Every value below is a default. The suite runs with none of them set, against a local stub.

# ---------------------------------------------------------------------------
# Target
# ---------------------------------------------------------------------------

# The API under test. No trailing slash.
#   local stub        http://127.0.0.1:3001
#   staging           https://api.staging.treveanspice.com
#   production        https://api.treveanspice.com
CONTRACT_TEST_BASE_URL=http://127.0.0.1:3001

# The OpenAPI document that governs the wire format. Defaults to the frozen M1 deliverable
# in this repository. Point it at the copy in the client repository once it lives there.
# CONTRACT_TEST_SPEC_PATH=../../deliverables/m1/01-api-contract.openapi.yaml

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# One bearer token per role. A token that is not set causes the tests for that role to be
# skipped rather than to fail, so the suite still runs usefully with partial credentials.
# The unauthenticated rejection tests never need a token and always run.
CONTRACT_TEST_TOKEN_ADMIN=stub-admin-token
CONTRACT_TEST_TOKEN_EDITOR=stub-editor-token
CONTRACT_TEST_TOKEN_VIEWER=stub-viewer-token

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------

# Whether the suite may create, update, publish and delete content on the target.
# SET THIS TO false WHEN POINTING AT PRODUCTION.
# The tests that assert an anonymous caller is refused still run, because a request that is
# correctly refused changes nothing.
CONTRACT_TEST_ALLOW_WRITES=true

# ---------------------------------------------------------------------------
# The tap path
# ---------------------------------------------------------------------------

# The origin the blend page is served from. Used by the beacon transport suite to check the
# CORS preflight that a cross origin navigator.sendBeacon call triggers.
CONTRACT_TEST_PAGE_ORIGIN=https://treveanspice.com

# ---------------------------------------------------------------------------
# Latency probe
# ---------------------------------------------------------------------------

# The <200 ms p95 content retrieval target from SOW section 6.2. This protects publish to
# live and the admin experience. It does NOT protect the 2.0 second tap budget, because the
# tap path does not call this API at all.
CONTRACT_TEST_LATENCY_P95_MS=200
CONTRACT_TEST_LATENCY_SAMPLES=30
CONTRACT_TEST_LATENCY_WARMUP=3

# Set to false to measure and print without failing the build. Useful from a laptop on a
# poor connection, where client network time dominates the measurement.
CONTRACT_TEST_LATENCY_ENFORCE=true

# ---------------------------------------------------------------------------
# Fixtures and tolerances
# ---------------------------------------------------------------------------

# Identifiers for the single resource operations. The suite discovers these from the target
# at run time and only falls back to these values when discovery finds nothing.
# CONTRACT_TEST_RECIPE_ID=rcp_01J9Z91B2C3D4E5F6G7H8J9K0M
# CONTRACT_TEST_GROWER_ID=grw_01J9Z900A1B2C3D4E5F6G7H8J9
# CONTRACT_TEST_MEDIA_ID=med_01J9Z8XK4M2Q7T5V3N8R1B6C0D

# Per request timeout in milliseconds.
CONTRACT_TEST_TIMEOUT_MS=10000

# Assert that JSON responses declare charset=utf-8, per section 8.1 of the contract.
CONTRACT_TEST_REQUIRE_CHARSET=true

# ---------------------------------------------------------------------------
# Stub only
# ---------------------------------------------------------------------------

# Port for `npm run stub`. The `npm run test:stub` script picks a free port itself.
STUB_PORT=3001
