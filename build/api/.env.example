# Configuration. Copy to .env.local for your own machine, and never commit a real value.
#
# SECRETS DO NOT LIVE HERE OUTSIDE LOCAL DEVELOPMENT. In staging and production every
# SECRET_* value below is read from AWS Secrets Manager instead, and the environment
# variable path is refused when STAGE is production. See src/config/secrets.ts.

STAGE=local
PORT=3001
LOG_LEVEL=info
AWS_REGION=us-east-1

# Point at DynamoDB Local (docker compose up dynamodb) or leave unset to use a real account.
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# The five tables. No sixth table: the catalog mirror, media, idempotency records,
# revalidation jobs and the rollups all live inside these under their own key namespaces.
TABLE_SPICE_BLENDS=SpiceBlends
TABLE_SCAN_EVENTS=ScanEvents
TABLE_RECIPES=Recipes
TABLE_GROWERS=Growers
TABLE_NFC_TAGS=NFCTags

INDEX_BLENDS_BY_STATUS=status-updatedAt-index
INDEX_BLENDS_BY_SLUG=slug-index
INDEX_BLENDS_BY_ENTITY=entity-createdAt-index
INDEX_RECIPE_BY_ID=recipeId-index
INDEX_GROWERS_BY_ENTITY_NAME=entity-name-index

MEDIA_BUCKET=trevean-media-local
MEDIA_CDN_BASE_URL=https://cdn.treveanspice.com
MEDIA_PRESIGN_EXPIRY_SECONDS=900
MEDIA_MAX_BYTES=26214400
# Set only when running an S3 compatible server locally.
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true

# Admin authentication. In staging and production set AUTH_JWKS_URI to the managed identity
# provider on the Trevean AWS account and leave the development token switch off.
AUTH_ISSUER=https://auth.local.treveanspice.com
AUTH_AUDIENCE=trevean-admin
# AUTH_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/POOL_ID/.well-known/jwks.json
AUTH_ALLOW_DEV_TOKENS=true
AUTH_DEV_SECRET_NAME=trevean/api/dev-jwt-secret

# Scan telemetry. Retention is proposed at 400 days so any month can be compared with the
# same month a year earlier, and is for Dan to confirm.
SCAN_RAW_RETENTION_DAYS=400
SCAN_ALLOWED_ORIGINS=https://treveanspice.com,https://www.treveanspice.com

CATALOG_STALE_AFTER_SECONDS=21600

# Where publish and revalidate post their queued paths. Unset means log only.
# REVALIDATION_WEBHOOK_URL=https://treveanspice.com/api/revalidate
REVALIDATION_SECRET_NAME=trevean/api/revalidation-secret
SHOPIFY_WEBHOOK_SECRET_NAME=trevean/api/shopify-webhook-secret

# Rate limits are enforced at the CDN and WAF so a flood never reaches a function. This in
# process limiter is defence in depth for an environment with nothing in front of it.
RATE_LIMIT_ENABLED=false

# LOCAL DEVELOPMENT ONLY. In every other stage these come from the managed secret store.
SECRET_TREVEAN_API_DEV_JWT_SECRET=local-development-signing-key-not-for-any-real-environment
SECRET_TREVEAN_API_SHOPIFY_WEBHOOK_SECRET=local-development-shopify-secret
SECRET_TREVEAN_API_REVALIDATION_SECRET=local-development-revalidation-secret
