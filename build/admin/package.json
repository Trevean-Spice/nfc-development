{
  "name": "@trevean/admin-cms",
  "version": "1.0.0",
  "private": true,
  "description": "Trevean Spice admin CMS. Blend, recipe and grower editors, role based access, preview before publish, and the NFC screens a generic CMS does not model. Built against the frozen M1 API contract, version 1.0.0.",
  "license": "LicenseRef-Trevean-Work-For-Hire",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run test/unit test/integration",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:live": "vitest run test/live",
    "test:watch": "vitest",
    "licences": "node scripts/licenses.mjs",
    "licences:check": "node scripts/licenses.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1130.0",
    "@fastify/aws-lambda": "^6.4.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "jose": "^5.9.3",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}
